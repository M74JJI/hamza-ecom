# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hajzen?schema=public"

# Application
# Use the canonical public HTTPS origin in production, e.g. https://shop.example.com
APP_URL="http://localhost:3000"

# Security
# Required in production. Use a random value of at least 32 characters.
RATE_LIMIT_HASH_SECRET=""

# Primary SMTP path used by checkout/order emails
SMTP_USER=""
SMTP_PASS=""

# Legacy Gmail mailer/auth utilities still present in the app
GMAIL_USER=""
GMAIL_APP_PASS=""
AUTH_EMAIL_FROM=""
SMTP_SECURE="true"

# Optional / currently not wired as the active mail transport
RESEND_API_KEY=""
