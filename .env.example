# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hajzen?schema=public"

# Application
# Use the canonical public HTTPS origin in production, e.g. https://shop.example.com
APP_URL="http://localhost:3000"

# Security
# Required in production. Use a random value of at least 32 characters.
RATE_LIMIT_HASH_SECRET=""

# Product media and rich-text editor (required for admin product editing)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
NEXT_PUBLIC_TINYMCE_API_KEY=""

# Email / SMTP
# SMTP_USER and SMTP_PASS are the canonical credentials.
# GMAIL_USER / GMAIL_APP_PASS remain supported as legacy aliases.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Hajzen Store <no-reply@example.com>"

# Legacy aliases (optional)
GMAIL_USER=""
GMAIL_APP_PASS=""
AUTH_EMAIL_FROM=""
